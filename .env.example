# ---- Camera (Tapo C110) ----
# User and password = the "camera account" created in the Tapo app.
# Special characters in the password must be encoded: @ -> %40
CAMERA_RTSP_URL=rtsp://camera_user:camera_password@192.168.1.50:554/stream2
# camera_id of this camera in the backend (GET /api/camaras)
CAMERA_ID=1

# ---- Backend ----
BACKEND_URL=https://safevision-backend-pw6t.onrender.com
IOT_API_KEY=change-this-key

# ---- AI ----
AI_ENABLED=true
POSE_MODEL=yolo11n-pose.pt
ANIMAL_MODEL=yolo11n.pt
# Model trained by the team (training/). Empty = only YOLO Pose + rules.
FALL_MODEL=
# Frames analyzed per second
ANALYSIS_FPS=5
# subject_id of the monitored person and pet (GET /api/sujetos). Empty = not identified.
PERSON_SUBJECT_ID=
PET_SUBJECT_ID=

# ---- Rules (seconds) ----
FALL_WINDOW_SECONDS=1.5
FALL_DROP_RATIO=0.3
FALL_CONFIRM_SECONDS=2
PERSON_IMMOBILITY_SECONDS=60
PET_IMMOBILITY_SECONDS=1800
ZONE_DWELL_SECONDS=2
EVENT_COOLDOWN_SECONDS=60
ZONES_REFRESH_SECONDS=300
EVIDENCE_DIR=evidence

# ---- Connection ----
HEARTBEAT_SECONDS=30
RECONNECT_SECONDS=5
REQUEST_TIMEOUT=90
